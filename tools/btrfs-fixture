#!/usr/bin/env python3
"""Run the btrfs and walk tests on a throw-away btrfs image.

The image holds what btrfs makes a walk get wrong: compressed files, reflinked
copies, a writable snapshot sharing every extent, a sparse file, inline files, and
hard links to an inline and a regular file. The tests are told where it is
mounted (LEITA_BTRFS_DIR, read only, and LEITA_BTRFS_SCRATCH, to write in) and
what a walk of it must total (LEITA_BTRFS_DISK).

That total is worked out from the image itself, not from a run of compsize:
`btrfs inspect-internal dump-tree` reads the image file without privilege, and
every regular extent is charged once, wherever it is referred to, and every inline
extent once per inode of each subvolume. compsize charges an inline extent once
for every path that reaches it, so a hard-linked inline file costs it once per
name; this charges it once, as the walk charges a file with several names.

Searching a file's extents needs CAP_SYS_ADMIN, so unprivileged the tests expect
the walk to fall back to st_blocks, and as root they expect the total.

How the image is mounted is chosen once, up front:

- run as root: losetup and mount directly, and the tests run as root;
- --sudo: the same through `sudo -n`, never udisks, and the tests run as this user
  and again as root, as on GitHub's Linux runners, which have udisksctl but no
  session for it. A sudo that asks for a password fails the run;
- otherwise: udisks, when `udisksctl status` answers, and the tests run as this
  user. Without it, or when udisks refuses the loop device, the run is skipped.

Only --sudo lets it use sudo at all, so credentials sudo happens to have cached
never turn an ordinary run into a root one. Whatever ran as root, the image is
detached and build/btrfs-fixture/ is handed back to this user. A machine without
btrfs-progs skips the run too; `just test` still runs every test there, each
predicting what it can check.

    tools/btrfs-fixture
    tools/btrfs-fixture --sudo          mount with sudo, never udisks, and test as root too
    tools/btrfs-fixture --keep          leave the image mounted afterwards
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
WORK = REPO / "build" / "btrfs-fixture"
IMAGE = WORK / "btrfs.img"
SIZE = 256 * 1024 * 1024  # mkfs.btrfs wants 114 MiB at least for a single device
WALK_TOTAL = "walk.test_walk_charges_btrfs_extents_or_says_why"
# The inline file the volume holds two names of (tiny and tiny.link).
TINY = b"small enough to sit inline in its metadata\n"


def say(text: str) -> None:
    print(f"btrfs-fixture: {text}", flush=True)


def run(argv: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(argv, check=True, **kw)


def quiet(argv: list[str]) -> bool:
    return subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def is_root() -> bool:
    return os.geteuid() == 0


def can_sudo() -> bool:
    return shutil.which("sudo") is not None and quiet(["sudo", "-n", "true"])


def has_udisks() -> bool:
    """Whether udisks answers this user at all. It may still refuse to set up a loop
    device, as on a CI runner with no polkit agent; Mount.attach says so then."""
    return shutil.which("udisksctl") is not None and quiet(["udisksctl", "status"])


class Skip(Exception):
    """This machine cannot mount the image; the run is skipped, not failed."""


class Mount:
    """The image, attached and mounted one way, chosen up front, and how to undo it.

    root: this script is root, so losetup and mount directly.
    sudo: --sudo, so the same through `sudo -n`, never udisks, so a runner that
          has udisksctl but no session for it cannot get in the way.
    udisks: neither, so udisksctl, as a desktop user may without a password.
    """

    def __init__(self, how: str) -> None:
        self.how = how
        self.dev = ""
        self.path = Path()

    def privileged(self, argv: list[str], **kw) -> subprocess.CompletedProcess:
        prefix = ["sudo", "-n"] if self.how == "sudo" else []
        return run(prefix + argv, **kw)

    def attach(self) -> None:
        """Attach and mount, or leave nothing attached and raise."""
        self.detach_stale()
        try:
            if self.how == "udisks":
                self.attach_udisks()
            else:
                self.dev = self.privileged(
                    ["losetup", "--find", "--show", str(IMAGE)], capture_output=True, text=True
                ).stdout.strip()
                self.path = WORK / "mnt"
                self.path.mkdir(exist_ok=True)
                self.privileged(["mount", self.dev, str(self.path)])
        except BaseException:
            self.detach()
            raise

    def attach_udisks(self) -> None:
        setup = subprocess.run(
            ["udisksctl", "loop-setup", "--no-user-interaction", "-f", str(IMAGE)],
            capture_output=True,
            text=True,
        )
        if setup.returncode != 0:
            raise Skip(f"udisks would not set up a loop device: {setup.stderr.strip()}")
        found = re.search(r"(/dev/loop\d+)", setup.stdout)
        if not found:
            raise RuntimeError(f"no loop device in: {setup.stdout.strip()}")
        self.dev = found[1]
        for _ in range(50):
            target = mounted_at(self.dev)
            if target:
                self.path = Path(target)
                return
            time.sleep(0.1)
        run(["udisksctl", "mount", "--no-user-interaction", "-b", self.dev], stdout=subprocess.DEVNULL)
        target = mounted_at(self.dev)
        if not target:
            raise RuntimeError(f"{self.dev} did not mount")
        self.path = Path(target)

    def detach(self) -> None:
        """Unmount and detach whatever attach got as far as; safe to call twice."""
        if self.dev:
            self.release(self.dev)
        self.dev = ""

    def release(self, dev: str) -> None:
        silent = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
        if self.how == "udisks":
            subprocess.run(["udisksctl", "unmount", "--no-user-interaction", "-b", dev], **silent)
            subprocess.run(["udisksctl", "loop-delete", "--no-user-interaction", "-b", dev], **silent)
            return
        prefix = ["sudo", "-n"] if self.how == "sudo" else []
        target = mounted_at(dev)
        if target:
            subprocess.run(prefix + ["umount", target], **silent)
        subprocess.run(prefix + ["losetup", "-d", dev], **silent)

    def detach_stale(self) -> None:
        """Undo a run that stopped before it cleaned up."""
        listed = subprocess.run(["losetup", "-j", str(IMAGE)], capture_output=True, text=True).stdout
        for line in listed.splitlines():
            dev = line.split(":", 1)[0]
            if dev.startswith("/dev/loop"):
                self.release(dev)


def mounted_at(dev: str) -> str:
    out = subprocess.run(["findmnt", "-no", "TARGET", dev], capture_output=True, text=True).stdout.strip()
    return out.splitlines()[0] if out else ""


def make_image() -> None:
    """An empty image whose top directory belongs to this user, so whoever mounts it,
    this user can fill it: mkfs.btrfs copies the owner of --rootdir."""
    seed = WORK / "seed"
    seed.mkdir(parents=True, exist_ok=True)
    with open(IMAGE, "wb") as f:
        f.truncate(SIZE)
    run(["mkfs.btrfs", "-q", "-f", "-L", "leita-btrfs-test", "-r", str(seed), str(IMAGE)])


def fill(top: Path) -> None:
    """The shape of the volume compsize was first checked on, plus hard links."""
    run(["btrfs", "-q", "subvolume", "create", str(top / "vol")], stdout=subprocess.DEVNULL)
    vol = top / "vol"
    (vol / "comp").mkdir()
    (vol / "plain").mkdir()
    (top / "scratch").mkdir()
    # Inherited by every file made in it afterwards.
    run(["btrfs", "property", "set", str(vol / "comp"), "compression", "zstd"])
    # The plain directory is kept uncompressed whatever the mount says.
    run(["chattr", "+m", str(vol / "plain")])
    text = b"".join(b"line %d of a file that compresses well\n" % i for i in range(60000))
    noise = os.urandom(1024 * 1024)
    for d in ("comp", "plain"):
        (vol / d / "text").write_bytes(text)
        (vol / d / "random").write_bytes(noise if d == "plain" else os.urandom(512 * 1024))
    run(["cp", "--reflink=always", str(vol / "plain/random"), str(vol / "plain/random.reflink")])
    run(["cp", "--reflink=always", str(vol / "comp/text"), str(vol / "plain/text.reflink")])
    with open(vol / "plain/sparse", "wb") as f:
        f.truncate(1024 * 1024)
        f.seek(512 * 1024)
        f.write(os.urandom(8192))
    (vol / "plain/tiny").write_bytes(TINY)
    os.link(vol / "plain/tiny", vol / "plain/tiny.link")
    os.link(vol / "plain/random", vol / "comp/random.link")
    run(["sync", "-f", str(top)])
    run(["btrfs", "-q", "subvolume", "snapshot", str(vol), str(top / "snap")], stdout=subprocess.DEVNULL)
    # A file only the snapshot has, so its tree is not the volume's.
    (top / "snap/plain/own").write_bytes(os.urandom(64 * 1024))
    run(["sync", "-f", str(top)])


def tree_id(path: Path) -> int:
    out = run(["btrfs", "inspect-internal", "rootid", str(path)], capture_output=True, text=True).stdout
    return int(out.strip())


def extents(tree: int) -> tuple[dict[int, int], dict[int, int]]:
    """One subvolume's regular extents by disk address, and its inline bytes by inode,
    from dump-tree over the image file."""
    out = run(
        ["btrfs", "inspect-internal", "dump-tree", "-t", str(tree), str(IMAGE)],
        capture_output=True,
        text=True,
    ).stdout.splitlines()
    regular: dict[int, int] = {}
    inline: dict[int, int] = {}
    for i, line in enumerate(out):
        key = re.search(r"item \d+ key \((\d+) EXTENT_DATA \d+\)", line)
        if not key:
            continue
        ino = int(key[1])
        if "(inline)" in out[i + 1]:
            size = re.search(r"inline extent data size (\d+)", out[i + 2])
            inline[ino] = inline.get(ino, 0) + int(size[1])
            continue
        where = re.search(r"disk byte (\d+) nr (\d+)", out[i + 2])
        if where and int(where[1]) != 0:
            regular[int(where[1])] = int(where[2])
    return regular, inline


def oracle(trees: list[int]) -> int:
    """What a walk over these subvolumes must charge."""
    seen: dict[int, int] = {}
    total = 0
    for tree in trees:
        regular, inline = extents(tree)
        seen.update(regular)
        total += sum(inline.values())
    return total + sum(seen.values())


def compsize_total(path: Path, how: str) -> int | None:
    """What compsize -b reports as the disk usage of `path`, or None where it cannot
    be had: not installed, or no root to search extents with (udisks)."""
    if not shutil.which("compsize") or how == "udisks":
        return None
    prefix = ["sudo", "-n"] if how == "sudo" else []
    done = subprocess.run(prefix + ["compsize", "-b", str(path)], capture_output=True, text=True)
    for line in done.stdout.splitlines():
        fields = line.split()
        if done.returncode == 0 and len(fields) >= 5 and fields[0] == "TOTAL":
            return int(fields[2])
    say(f"compsize gave nothing to compare: {done.stdout.strip()} {done.stderr.strip()}")
    return None


def build(odin: str, flags: list[str], package: str, out: Path, define: str = "") -> None:
    argv = [odin, "build", package, "-build-mode:test", *flags, f"-out:{out}"]
    if define:
        argv.append(f"-define:ODIN_TEST_NAMES={define}")
    run(argv, cwd=REPO)


def run_tests(binary: Path, env: dict[str, str], as_root: bool) -> bool:
    argv = [str(binary)]
    if as_root and not is_root():
        argv = ["sudo", "-n", "env", *(f"{k}={v}" for k, v in env.items()), str(binary)]
    who = "root" if as_root else "unprivileged"
    say(f"{binary.name} as {who}, {' '.join(f'{k}={v}' for k, v in env.items())}")
    done = subprocess.run(argv, env={**os.environ, **env}, cwd=REPO)
    return done.returncode == 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--odin", default=os.environ.get("ODIN", "odin"))
    parser.add_argument("--flags", default="", help="what the justfile builds tests with")
    parser.add_argument("--keep", action="store_true", help="leave the image mounted")
    parser.add_argument("--sudo", action="store_true", help="mount with sudo -n, never udisks, and test as root too")
    args = parser.parse_args()

    if sys.platform != "linux":
        say("skipped: btrfs is Linux's")
        return 0
    for tool in ("mkfs.btrfs", "btrfs", "losetup", "findmnt"):
        if not shutil.which(tool):
            say(f"skipped: {tool} is not installed")
            return 0
    if is_root():
        how = "root"
    elif args.sudo:
        # Asked for, so a sudo that wants a password is a failure, not a skip.
        if not can_sudo():
            say("FAILED: --sudo was given but sudo -n is refused")
            return 1
        how = "sudo"
    elif has_udisks():
        how = "udisks"
    else:
        say("skipped: cannot mount an image here: no udisks for this user, and no --sudo")
        return 0

    WORK.mkdir(parents=True, exist_ok=True)
    flags = args.flags.split() or subprocess.run(
        ["just", "--evaluate", "flags"], capture_output=True, text=True, cwd=REPO, check=True
    ).stdout.split()
    flags = ["-debug", *flags]
    walk_all, walk_total, btrfs_all = WORK / "walk-test", WORK / "walk-total-test", WORK / "btrfs-test"
    build(args.odin, flags, "walk", walk_all)
    build(args.odin, flags, "walk", walk_total, WALK_TOTAL)
    build(args.odin, flags, "btrfs", btrfs_all)

    mount = Mount(how)
    ok = False
    try:
        make_image()
        mount.attach()
        top = mount.path
        say(f"mounted {IMAGE} at {top} ({how})")
        fill(top)
        vol_tree, snap_tree, top_tree = tree_id(top / "vol"), tree_id(top / "snap"), tree_id(top)
        vol_disk = oracle([vol_tree])
        all_disk = oracle([top_tree, vol_tree, snap_tree])
        say(f"oracle: vol {vol_disk} bytes, whole mount {all_disk} bytes")
        scratch = str(top / "scratch")
        # compsize charges an inline extent once per name; the oracle once per inode
        # and subvolume. tiny has two names, in one subvolume (vol) or two (the snapshot
        # holds it too), so it costs compsize one more TINY per subvolume.
        vol_env: dict[str, str] = {}
        top_env: dict[str, str] = {}
        vol_compsize, top_compsize = compsize_total(top / "vol", how), compsize_total(top, how)
        if vol_compsize is not None:
            vol_env = {"LEITA_BTRFS_COMPSIZE": str(vol_compsize), "LEITA_BTRFS_COMPSIZE_EXTRA": str(len(TINY))}
            say(f"compsize: vol {vol_compsize} bytes, oracle {vol_disk} + {len(TINY)} inline")
        if top_compsize is not None:
            top_env = {"LEITA_BTRFS_COMPSIZE": str(top_compsize), "LEITA_BTRFS_COMPSIZE_EXTRA": str(2 * len(TINY))}
            say(f"compsize: whole mount {top_compsize} bytes, oracle {all_disk} + {2 * len(TINY)} inline")
        runs = [
            (walk_all, {"LEITA_BTRFS_DIR": str(top / "vol"), "LEITA_BTRFS_DISK": str(vol_disk), "LEITA_BTRFS_SCRATCH": scratch, **vol_env}),
            (walk_total, {"LEITA_BTRFS_DIR": str(top), "LEITA_BTRFS_DISK": str(all_disk), **top_env}),
            (btrfs_all, {"LEITA_BTRFS_SCRATCH": scratch}),
        ]
        privileges = {"root": [True], "sudo": [False, True], "udisks": [False]}[how]
        if how == "udisks":
            say("as root: not run; give --sudo where sudo asks no password, or run this as root")
        ok = True
        for as_root in privileges:
            for binary, env in runs:
                ok = run_tests(binary, env, as_root) and ok
    except Skip as why:
        say(f"skipped: {why}")
        return 0
    finally:
        if args.keep and ok:
            say(f"kept mounted at {mount.path}")
        else:
            mount.detach()
            IMAGE.unlink(missing_ok=True)
        give_back(how, args.keep and ok)
    say("passed" if ok else "FAILED")
    return 0 if ok else 1


def give_back(how: str, kept: bool) -> None:
    """Leave build/btrfs-fixture/ to the user, whatever ran as root in it. A mount
    kept is left alone: its files are the image's."""
    if how == "sudo":
        uid, gid = os.getuid(), os.getgid()
        prefix = ["sudo", "-n"]
    elif how == "root" and os.environ.get("SUDO_UID"):
        uid, gid = int(os.environ["SUDO_UID"]), int(os.environ.get("SUDO_GID", os.environ["SUDO_UID"]))
        prefix = []
    else:
        return
    argv = prefix + ["chown", "-R", "--one-file-system", f"{uid}:{gid}", str(WORK)]
    if kept:
        argv = prefix + ["find", str(WORK), "-xdev", "-exec", "chown", "-h", f"{uid}:{gid}", "{}", "+"]
    subprocess.run(argv, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    sys.exit(main())
