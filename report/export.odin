package report

import "core:io"
import "core:path/filepath"
import "core:strings"
import "core:time"
import "core:unicode/utf8"

import "jm:timefmt"

import "../kinds"
import "../reclaim"
import "../scan"

/*
Format is how a report is written.

CSV and HTML are for a person reading: a byte of a path that is not UTF-8 reads as
U+FFFD, and a control character as its Unicode control picture (a newline as ␊),
so a hostile name stays on its own row and cannot break the page. JSON is for a
program: a path is its exact text, and one that is not UTF-8 is also given whole,
as base64, beside it (SCHEMA.md).
*/
Format :: enum u8 {
	Csv,
	Json,
	Html,
	Pdf,
}

Error :: enum u8 {
	None,
	Pdf_Not_Built,
	Write_Failed,
}

ERROR_TEXT := [Error]string {
	.None          = "",
	.Pdf_Not_Built = "PDF export is not built yet",
	.Write_Failed  = "could not write the report",
}

// format_of is the format a file's extension names, ignoring case.
format_of :: proc(path: string) -> (Format, bool) {
	ext := filepath.ext(path)
	switch {
	case strings.equal_fold(ext, ".csv"):
		return .Csv, true
	case strings.equal_fold(ext, ".json"):
		return .Json, true
	case strings.equal_fold(ext, ".html"), strings.equal_fold(ext, ".htm"):
		return .Html, true
	case strings.equal_fold(ext, ".pdf"):
		return .Pdf, true
	}
	return {}, false
}

// format_named is the format a name says, as the command line takes it.
format_named :: proc(name: string) -> (Format, bool) {
	for f in Format {
		if strings.equal_fold(name, FORMAT_NAMES[f]) {
			return f, true
		}
	}
	return {}, false
}

FORMAT_NAMES := [Format]string {
	.Csv  = "csv",
	.Json = "json",
	.Html = "html",
	.Pdf  = "pdf",
}

/*
export writes r to w as format. It is the one call every export goes through,
the command line's and later the window's, so whatever decides who may export
wraps this alone.
*/
export :: proc(w: io.Writer, r: ^Report, format: Format) -> Error {
	sb := strings.builder_make(context.temp_allocator)
	switch format {
	case .Csv:
		write_csv(&sb, r)
	case .Json:
		write_json(&sb, r)
	case .Html:
		write_html(&sb, r)
	case .Pdf:
		return .Pdf_Not_Built
	}
	if _, err := io.write_string(w, strings.to_string(sb)); err != nil {
		return .Write_Failed
	}
	return .None
}

// The names a program reads: lower case, stable across versions of the schema.
@(private)
FILESYSTEM_KEYS := [scan.Filesystem]string {
	.Unknown = "",
	.Ntfs    = "ntfs",
	.Refs    = "refs",
	.Exfat   = "exfat",
	.Fat32   = "fat32",
	.Network = "network",
	.Other   = "other",
}

// FILESYSTEM_NAMES are the filesystems as a person reads them.
@(private)
FILESYSTEM_NAMES := [scan.Filesystem]string {
	.Unknown = "",
	.Ntfs    = "NTFS",
	.Refs    = "ReFS",
	.Exfat   = "exFAT",
	.Fat32   = "FAT32",
	.Network = "Network share",
	.Other   = "Other",
}

@(private)
ENGINE_KEYS := [scan.Engine]string {
	.None      = "",
	.Mft       = "mft",
	.Walk      = "walk",
	.Synthetic = "synthetic",
}

@(private)
KIND_KEYS := [kinds.Kind]string {
	.Folder     = "folder",
	.Multimedia = "multimedia",
	.Image      = "image",
	.Archive    = "archive",
	.Document   = "document",
	.Text       = "text",
	.Binary     = "binary",
	.Cache      = "cache",
	.Other      = "other",
}

@(private)
CATEGORY_KEYS := [reclaim.Category]string {
	.Dependencies  = "dependencies",
	.Build_Output  = "build_output",
	.Python        = "python",
	.Package_Cache = "package_cache",
	.App_Cache     = "app_cache",
	.Trash         = "trash",
}

// iso is t as ISO 8601 in UTC to the second, or "" for a time never set.
@(private)
iso :: proc(t: time.Time) -> string {
	if t == {} {
		return ""
	}
	return timefmt.iso(t, context.temp_allocator)
}

// generated_by is the line every format ends with.
@(private)
generated_by :: proc(r: ^Report) -> string {
	return strings.concatenate(
		{"Generated by estoile ", r.version, " on ", iso(r.generated)},
		context.temp_allocator,
	)
}

/*
readable is s as the display formats show it: a byte that is not UTF-8 as
U+FFFD, and a C0 control or DEL as its control picture (U+2400 to U+2421), so it
neither breaks a row nor hides. Text that needs neither comes back as it is.
*/
@(private)
readable :: proc(s: string) -> string {
	clean := true
	for i := 0; i < len(s); {
		r, size := utf8.decode_rune_in_string(s[i:])
		if (r == utf8.RUNE_ERROR && size == 1) || r < 0x20 || r == 0x7f {
			clean = false
			break
		}
		i += size
	}
	if clean {
		return s
	}
	sb := strings.builder_make(context.temp_allocator)
	for i := 0; i < len(s); {
		r, size := utf8.decode_rune_in_string(s[i:])
		switch {
		case r == utf8.RUNE_ERROR && size == 1:
			strings.write_rune(&sb, utf8.RUNE_ERROR)
		case r < 0x20:
			strings.write_rune(&sb, 0x2400 + r)
		case r == 0x7f:
			strings.write_rune(&sb, 0x2421)
		case:
			strings.write_string(&sb, s[i:i + size])
		}
		i += size
	}
	return strings.to_string(sb)
}
