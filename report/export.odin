package report

import "core:io"
import "core:path/filepath"
import "core:strings"
import "core:time"

import "jm:timefmt"

import "../human"
import "../kinds"
import "../reclaim"
import "../scan"

/*
Format is how a report is written.

CSV, HTML and PDF are for a person reading: a byte of a path that is not UTF-8 reads as
U+FFFD, and a control character as its Unicode control picture (a newline as ␊),
so a hostile name stays on its own row and cannot break the page (human.shown). JSON is for a
program: a path is its exact text, and one that is not UTF-8 is also given whole,
as base64, beside it (SCHEMA.md).
*/
Format :: enum u8 {
	Csv,
	Json,
	Html,
	Pdf,
}

Error :: enum u8 {
	None,
	No_Font,
	Write_Failed,
}

ERROR_TEXT := [Error]string {
	.None         = "",
	.No_Font      = "no font to set a PDF in: install Liberation Sans, Noto Sans or DejaVu Sans",
	.Write_Failed = "could not write the report",
}

// format_of is the format a file's extension names, ignoring case.
format_of :: proc(path: string) -> (Format, bool) {
	ext := filepath.ext(path)
	switch {
	case strings.equal_fold(ext, ".csv"):
		return .Csv, true
	case strings.equal_fold(ext, ".json"):
		return .Json, true
	case strings.equal_fold(ext, ".html"), strings.equal_fold(ext, ".htm"):
		return .Html, true
	case strings.equal_fold(ext, ".pdf"):
		return .Pdf, true
	}
	return {}, false
}

// format_named is the format a name says, as the command line takes it.
format_named :: proc(name: string) -> (Format, bool) {
	for f in Format {
		if strings.equal_fold(name, FORMAT_NAMES[f]) {
			return f, true
		}
	}
	return {}, false
}

FORMAT_NAMES := [Format]string {
	.Csv  = "csv",
	.Json = "json",
	.Html = "html",
	.Pdf  = "pdf",
}

// basic_export is a CSV or JSON of the current scan, which is free for
// everyone. PDF and HTML are Pro reports.
basic_export :: proc(format: Format) -> bool {
	return format == .Csv || format == .Json
}

/*
export writes r to w as format, a PDF on paper. It is the one call every export
goes through, the command line's and the window's, so whatever decides who may
export wraps this alone. Nothing is written to w when the format cannot be made.
*/
export :: proc(w: io.Writer, r: ^Report, format: Format, paper := Paper.A4) -> Error {
	sb := strings.builder_make(context.temp_allocator)
	switch format {
	case .Csv:
		write_csv(&sb, r)
	case .Json:
		write_json(&sb, r)
	case .Html:
		write_html(&sb, r)
	case .Pdf:
		return write_pdf(w, r, paper)
	}
	if _, err := io.write_string(w, strings.to_string(sb)); err != nil {
		return .Write_Failed
	}
	return .None
}

// The names a program reads: lower case, stable across versions of the schema.
@(private)
FILESYSTEM_KEYS := [scan.Filesystem]string {
	.Unknown = "",
	.Ntfs    = "ntfs",
	.Refs    = "refs",
	.Exfat   = "exfat",
	.Fat32   = "fat32",
	.Network = "network",
	.Other   = "other",
}

// FILESYSTEM_NAMES are the filesystems as a person reads them.
@(private)
FILESYSTEM_NAMES := [scan.Filesystem]string {
	.Unknown = "",
	.Ntfs    = "NTFS",
	.Refs    = "ReFS",
	.Exfat   = "exFAT",
	.Fat32   = "FAT32",
	.Network = "Network share",
	.Other   = "Other",
}

@(private)
ENGINE_KEYS := [scan.Engine]string {
	.None      = "",
	.Mft       = "mft",
	.Walk      = "walk",
	.Synthetic = "synthetic",
}

@(private)
KIND_KEYS := [kinds.Kind]string {
	.Folder     = "folder",
	.Multimedia = "multimedia",
	.Image      = "image",
	.Archive    = "archive",
	.Document   = "document",
	.Text       = "text",
	.Binary     = "binary",
	.Cache      = "cache",
	.Other      = "other",
}

@(private)
CATEGORY_KEYS := [reclaim.Category]string {
	.Dependencies   = "dependencies",
	.Build_Output   = "build_output",
	.Python         = "python",
	.Package_Cache  = "package_cache",
	.App_Cache      = "app_cache",
	.Device_Support = "device_support",
	.Trash          = "trash",
}

// iso is t as ISO 8601 in UTC to the second, or "" for a time never set.
@(private)
iso :: proc(t: time.Time) -> string {
	if t == {} {
		return ""
	}
	return timefmt.iso(t, context.temp_allocator)
}

// generated_by is the line every format ends with: what built it, when, and
// whose licence it ran under.
@(private)
generated_by :: proc(r: ^Report) -> string {
	return strings.concatenate(
		{"Generated by leita ", r.version, " on ", iso(r.generated), ". ", licensed_by(r)},
		context.temp_allocator,
	)
}

// licensed_by says whose licence the leita that built r runs under, as a
// sentence: a report handed on says whether it came from a licensed copy, a
// free export of the current scan, or a Pro report made during the evaluation.
@(private)
licensed_by :: proc(r: ^Report) -> string {
	if r.licensee != "" {
		return strings.concatenate(
			{"Licensed to ", readable(r.licensee), "."},
			context.temp_allocator,
		)
	}
	if r.free_export {
		return FREE_EXPORT
	}
	return UNLICENSED
}

// FREE_EXPORT is what a CSV or JSON of the current scan says of itself when no
// licence is in use and no earlier scan is attached. It is free for everyone,
// so it does not say it was made during the evaluation.
FREE_EXPORT :: "Free export of the current scan."

// UNLICENSED is what a Pro report built without a licence says of it. The
// evaluation is named, so a reader does not take a PDF or HTML for a copy
// anyone may hand on as licensed.
UNLICENSED :: "Unlicensed copy made during the 30-day Pro evaluation."

// NONE_EARLIER is the note when this report compares with nothing because
// there is no earlier scan of the place.
NONE_EARLIER :: "No earlier scan to compare with."

// EARLIER_KEPT is the note when an earlier scan was kept and this report does
// not compare with it. It must not say there was no earlier scan.
EARLIER_KEPT :: "An earlier scan is kept, and not compared."

// comparison_note is that note, or "" when this report does compare.
comparison_note :: proc(r: ^Report) -> string {
	if r.compared != nil {
		return ""
	}
	return EARLIER_KEPT if r.earlier_kept else NONE_EARLIER
}

// readable is s as the display formats show it, a name made safe to print:
// see human.shown. Exported for the history record the CLI prints.
readable :: proc(s: string) -> string {
	return human.shown(s)
}
