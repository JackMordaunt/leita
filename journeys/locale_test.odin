package journeys

import "core:fmt"
import "core:os"
import "core:strings"
import "core:testing"
import "core:time"

import "jm:timefmt"

/*
The command line is run in the locales and zones of people who are not on the
developer's machine, as a process of its own with LANG, LC_ALL and TZ set for that
run alone. Nothing the person reads or saves may change with them but the clock's
own words: sizes keep their decimal point (de_DE writes a comma), a name keeps its
bytes (tr_TR lowers I to the dotless ı), a report is the same file, and the
paper a PDF is laid out on is the locale's only where the locale says so.
*/

// WESTERN and EASTERN are what a person on another machine has set, each as the
// environment of one run: a language alone, a collation or a number format set
// over it, a byte encoding that is not UTF-8, a right-to-left language, and the
// two names for no language. Two lists, so two journeys run side by side.
@(private = "file", rodata)
WESTERN := [?][]string {
	{"LANG=de_DE.UTF-8"},
	{"LC_ALL=de_DE.UTF-8", "LANG=en_US.UTF-8"},
	{"LC_ALL=tr_TR.UTF-8"},
	{"LANG=tr_TR.ISO-8859-9"},
	{"LC_ALL=ar_SA.UTF-8"},
	{"LANG=C", "LC_NUMERIC=de_DE.UTF-8", "LC_TIME=de_DE.UTF-8", "LC_COLLATE=tr_TR.UTF-8"},
}

@(private = "file", rodata)
EASTERN := [?][]string {
	{"LANG=ja_JP.UTF-8"},
	{"LC_ALL=ja_JP.eucJP", "LANG=ja_JP.eucJP"},
	{"LC_ALL=ja_JP.SJIS"},
	{"LC_ALL=C"},
	{"LC_ALL=POSIX"},
	{"LANGUAGE=de:ja", "LANG=de_DE.UTF-8"},
}

// differ is the first line at which a and b differ, "" when they do not.
@(private = "file")
differ :: proc(a, b: string) -> string {
	left := strings.split_lines(a, context.temp_allocator)
	right := strings.split_lines(b, context.temp_allocator)
	for line, i in left {
		if i >= len(right) || line != right[i] {
			return fmt.tprintf("line %d: %q, not %q", i + 1, line, right[i] if i < len(right) else "")
		}
	}
	if len(right) > len(left) {
		return fmt.tprintf("ends at line %d, not %d", len(left), len(right))
	}
	return ""
}

// without drops the lines of text that begin with a prefix.
@(private = "file")
without :: proc(text: string, prefix: string) -> string {
	kept := make([dynamic]string, context.temp_allocator)
	for line in strings.split_lines(text, context.temp_allocator) {
		if !strings.has_prefix(line, prefix) {
			append(&kept, line)
		}
	}
	return strings.join(kept[:], "\n", context.temp_allocator)
}

// A scan reads out the same text, the same report and the same numbers in every
// locale, down to the byte: only how long it took is its own. A size typed with a
// point is read as one in a locale that writes its decimals with a comma.
@(private = "file")
expect_same_in :: proc(t: ^testing.T, name: string, sets: [][]string) {
	h := home(t, name)
	defer leave(h)

	// One run is the summary on standard output and the CSV report beside it.
	scan :: proc(t: ^testing.T, h: Home, name: string, set: []string) -> (out, csv: string, ok: bool) {
		file := file_in(h, fmt.tprintf("%s.csv", name))
		r := run(t, h, 0, "--no-history", "--min-free", "1.5GB", "--report", file, "/Users/alex", extra = set)
		if !expect_code(t, r, 0) {
			return
		}
		// The "tree" line says how many milliseconds the read took, the "report"
		// line names the file it wrote, and the CSV says when it was made.
		return without(without(r.out, "tree "), "report "), without(read_file(file), "note,,Generated by"), true
	}

	base, base_csv, _ := scan(t, h, "base", {"LC_ALL=C"})
	testing.expect(t, strings.contains(base, "32.7 GB  "), base)
	testing.expect(t, strings.contains(base, "largest files (20)"), base)
	testing.expect(t, strings.contains(slashes(base_csv), "directory,1,/Users/alex/Users,Folder,206005809152,64.21,"), base_csv)

	for set, i in sets {
		out, csv, ok := scan(t, h, fmt.tprintf("l%d", i), set)
		if !ok {
			continue
		}
		testing.expectf(t, out == base, "%v: the summary differs from the C locale's at %s", set, differ(out, base))
		testing.expectf(t, !strings.contains(out, "32,7 GB"), "%v: a decimal comma in %s", set, out)
		testing.expectf(t, csv == base_csv, "%v: the CSV report differs from the C locale's at %s", set, differ(csv, base_csv))
	}
}

@(test)
a_scan_reads_the_same_in_western_locales :: proc(t: ^testing.T) {
	expect_same_in(t, "locale_western", WESTERN[:])
}

@(test)
a_scan_reads_the_same_in_eastern_locales_and_the_c_locale :: proc(t: ^testing.T) {
	expect_same_in(t, "locale_eastern", EASTERN[:])
}

// PAPERS are what the environment says of the paper and the page a PDF then has,
// by POSIX's order: LC_ALL, else LC_PAPER, else LANG; the region decides, not the
// language.
@(private = "file", rodata)
PAPERS := [?]struct {
	all, paper, lang: string,
	letter:           bool,
} {
	{"", "", "", false},
	{"", "", "en_US.UTF-8", true},
	{"", "", "tr_TR.UTF-8", false},
	{"", "", "ja_JP.eucJP", false},
	{"de_DE.UTF-8", "", "en_US.UTF-8", false},
	{"C", "", "en_US.UTF-8", false},
	{"", "en_US.UTF-8", "de_DE.UTF-8", true},
}

// A PDF the person did not ask a paper for is on the paper their locale prints on.
@(test)
a_pdf_takes_the_paper_of_the_locale :: proc(t: ^testing.T) {
	h := home(t, "locale_paper")
	defer leave(h)

	for p, i in PAPERS {
		file := file_in(h, fmt.tprintf("paper-%d.pdf", i))
		set := [?]string {
			fmt.tprintf("LC_ALL=%s", p.all),
			fmt.tprintf("LC_PAPER=%s", p.paper),
			fmt.tprintf("LANG=%s", p.lang),
		}
		r := run(
			t,
			h,
			0,
			"--no-history",
			"--report",
			file,
			"/Users/alex",
			extra = set[:],
		)
		if !expect_code(t, r, 0) {
			continue
		}
		want := "/MediaBox [0 0 612" if p.letter else "/MediaBox [0 0 595"
		testing.expectf(
			t,
			strings.contains(read_file(file), want),
			"LC_ALL=%q LC_PAPER=%q LANG=%q: no %s",
			p.all,
			p.paper,
			p.lang,
			want,
		)
	}
}

// ZONES are zones whose offsets from UTC the journey knows without asking the
// zone database, as they have no clock change: whole hours either side of the
// day, a half hour, and three quarters of one.
@(private = "file", rodata)
ZONES := [?]struct {
	tz:     string,
	offset: time.Duration,
} {
	{"UTC", 0},
	{"Asia/Kolkata", 5 * time.Hour + 30 * time.Minute},
	{"Asia/Kathmandu", 5 * time.Hour + 45 * time.Minute},
	{"Pacific/Kiritimati", 14 * time.Hour},
	{"Pacific/Pago_Pago", -11 * time.Hour},
}

// utc_of reads 2026-10-25T14:23:34Z.
@(private = "file")
utc_of :: proc(iso: string) -> (time.Time, bool) {
	return timefmt.parse(iso, "%Y-%m-%dT%H:%M:%SZ")
}

// The scan before is worded in the zone the next is read in, the same instant
// whichever zone it was taken in: the person flies between two scans, the report
// stays in UTC, and "since" says the local time of the machine they are on.
@(test)
a_change_of_zone_between_scans_moves_the_wording_not_the_instant :: proc(t: ^testing.T) {
	// The zone is TZ on Linux and macOS. Odin's Windows reader (tz_windows.odin)
	// takes it from the registry and ignores TZ, so there the wording is only
	// checked for its shape.
	h := home(t, "zone_scan")
	defer leave(h)

	for here, i in ZONES {
		there := ZONES[(i + 1) % len(ZONES)]
		// Taken in one zone...
		in_here := [?]string{fmt.tprintf("TZ=%s", here.tz)}
		in_there := [?]string{fmt.tprintf("TZ=%s", there.tz)}
		first := run(t, h, 0, "--report", "-", "--format", "json", "/Users/alex", extra = in_here[:])
		if !expect_code(t, first, 0) {
			continue
		}
		doc := report(t, first.out)
		begin, begun := utc_of(member(doc, "scan")["started"].(string) or_else "")
		end, ended := utc_of(doc["generated"].(string) or_else "")
		if !testing.expect(t, begun && ended, "the report has no times") {
			continue
		}
		// ...and compared with, read in another.
		second := run(t, h, 0, "/Users/alex", extra = in_there[:])
		expect_code(t, second, 0)
		// The scan was taken between the report's start and its writing; a minute
		// may turn between them.
		_, _ = begin, end
		when ODIN_OS == .Windows {
			testing.expectf(t, strings.contains(second.out, "history    unchanged since 20"), "%s", second.out)
		} else {
			wants := [2]string {
				timefmt.format(time.time_add(begin, there.offset), "%Y-%m-%d %H:%M", context.temp_allocator),
				timefmt.format(time.time_add(end, there.offset), "%Y-%m-%d %H:%M", context.temp_allocator),
			}
			testing.expectf(
				t,
				strings.contains(second.out, fmt.tprintf("history    unchanged since %s\n", wants[0])) ||
				strings.contains(second.out, fmt.tprintf("history    unchanged since %s\n", wants[1])),
				"scanned in %s, read in %s: want %v in\n%s",
				here.tz,
				there.tz,
				wants,
				second.out,
			)
		}
	}
}

// A person whose profile folder has letters outside ASCII in its name, in a
// Cyrillic, Turkish and Japanese spelling at once: the history is kept there,
// the next scan reads it and compares, and the record can be listed.
@(test)
a_profile_with_a_non_ascii_name_keeps_and_compares_history :: proc(t: ^testing.T) {
	h := home(t, "Ünal_Çağlar_Иван_日本語")
	defer leave(h)

	r := run(t, h, 0, "/Users/alex")
	expect_code(t, r, 0)
	testing.expect(t, strings.contains(r.out, "history    the first scan of this place kept"), r.out)
	r = run(t, h, 0, "/Users/alex")
	expect_code(t, r, 0)
	testing.expect(t, strings.contains(r.out, "history    unchanged since "), r.out)
	testing.expect(t, os.exists(fmt.tprintf("%s/history.db", data(h))), data(h))
	r = run(t, h, 0, "history")
	expect_code(t, r, 0)
	testing.expect(t, strings.contains(r.out, "nothing recorded"), r.out)
}
